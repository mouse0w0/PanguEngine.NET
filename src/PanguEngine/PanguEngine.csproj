<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageId>PanguEngine</PackageId>
        <Version>0.1.0</Version>
        <Description>PanguEngine voxel game engine</Description>
        <Authors>PanguEngine</Authors>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugType>embedded</DebugType>
        <EmbedAllSources>true</EmbedAllSources>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FreeTypeSharp" Version="3.1.0" />
        <PackageReference Include="GpuMemoryAllocator.vma" Version="3.3.0-0.2.0" />
        <PackageReference Include="GpuMemoryAllocator.Vulkan" Version="3.3.0-0.2.0" />
        <PackageReference Include="HarfBuzzSharp" Version="14.2.1.2" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.2" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.7" />
        <PackageReference Include="NLog" Version="6.1.3" />
        <PackageReference Include="NLog.Extensions.Logging" Version="6.1.3" />
        <PackageReference Include="NVorbis" Version="0.10.5" />
        <PackageReference Include="Silk.NET.Core" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
        <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Shaderc" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Vulkan.Extensions.EXT" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
        <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
        <PackageReference Include="StbImageSharp" Version="2.30.15" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="assets\**\*"
                 Link="assets\%(RecursiveDir)%(Filename)%(Extension)"
                 Pack="true"
                 PackagePath="assets\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>

        <None Update="native\win-x64\OpenAL32.dll"
              Condition="Exists('native\win-x64\OpenAL32.dll')"
              CopyToOutputDirectory="Always"
              Link="OpenAL32.dll"
              Pack="true"
              PackagePath="runtimes\win-x64\native\OpenAL32.dll" />

        <None Update="licenses\**\*.txt"
              CopyToOutputDirectory="Always"
              Link="licenses\%(RecursiveDir)%(Filename)%(Extension)"
              Pack="true"
              PackagePath="licenses\%(RecursiveDir)%(Filename)%(Extension)" />

        <None Update="buildTransitive\PanguEngine.targets"
              Pack="true"
              PackagePath="buildTransitive\PanguEngine.targets" />
    </ItemGroup>

</Project>
